<Window x:Class="WinQuick.App.Radial.SettingsPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinQuick 设置"
        Width="404" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!-- 样式全部走 DynamicResource 引用令牌，不写死任何颜色与字号。
         之前那版设置界面在 XAML 里硬编码颜色，结果和轮盘的视觉语言各写一套、
         很快就长得不一样，而且不受 tokens.json 与规格护栏约束。 -->
    <Window.Resources>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Wq.Color.FieldBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Wq.Color.Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="{DynamicResource Wq.Size.FieldPadding}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.BodySize}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Wq.Color.Text}" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.Text}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.BodySize}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.Accent}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.BodySize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.TextMuted}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.SmallSize}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <!-- 扁平按钮：默认透明、悬停浅色底。与轮盘上的操作条同一套观感。 -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.Text}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.BodySize}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Wq.Color.Stroke}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Wq.Size.ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource Wq.Color.FieldBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.Text}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.BodySize}" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
    </Window.Resources>

    <!-- 面板本体：与轮盘扇区同一套材质 —— 半透明深底 + 一圈细描边 + 圆角。
         刻意不用投影：WPF 的 Effect 会占中间表面、叠多了会让整窗退化到软件渲染。 -->
    <Border Background="{DynamicResource Wq.Color.SurfaceSolid}"
            BorderBrush="{DynamicResource Wq.Color.Stroke}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Wq.Size.CornerRadius}"
            Opacity="0.97">
        <!-- 内容可滚动：面板项目不少（热键、外观、行为、菜单项、启动），
             加上菜单列表后总高度可能超过屏幕可用高度。
             不设滚动的话在小屏上底部的按钮会被截掉、点不到。 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,2,0">
        <StackPanel Margin="18,14,18,16">

            <!-- 标题栏 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="设置"
                           Foreground="{DynamicResource Wq.Color.Text}"
                           FontFamily="{DynamicResource Wq.Font.Family}"
                           FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource FlatButton}"
                        Padding="9,2" Content="✕" Click="OnCloseClick"
                        ToolTip="关闭设置（Esc）" />
            </Grid>

            <!-- ============ 热键 ============ -->
            <TextBlock Text="热键" Style="{StaticResource Section}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="HotkeyBox" Grid.Column="0" Style="{StaticResource Field}"
                         IsReadOnly="True" FontSize="15"
                         PreviewKeyDown="OnHotkeyKeyDown"
                         GotKeyboardFocus="OnHotkeyFocused"
                         ToolTip="点这里然后按下想要的组合键" />
                <Button x:Name="TestButton" Grid.Column="1" Style="{StaticResource FlatButton}"
                        Margin="8,0,0,0" Content="测试" Click="OnTestHotkeyClick" />
            </Grid>
            <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}" Margin="0,6,0,0" />

            <!-- ============ 外观 ============ -->
            <TextBlock Text="外观" Style="{StaticResource Section}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="遮罩深浅" Style="{StaticResource Caption}" />
                <Slider x:Name="DimSlider" Grid.Column="1" Margin="12,0" Minimum="0" Maximum="0.9"
                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                        ValueChanged="OnDimChanged" />
                <TextBlock x:Name="DimValue" Grid.Column="2" Style="{StaticResource Caption}"
                           Width="64" TextAlignment="Right" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="拖动即可看到遮罩变化。40% 是默认值；与默认值相同时不会在配置里留下记录。" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="悬停高亮色" Style="{StaticResource Caption}" />
                <TextBox x:Name="AccentBox" Grid.Column="1" Style="{StaticResource Field}"
                         Margin="12,0,0,0" FontFamily="Consolas"
                         TextChanged="OnAccentChanged"
                         ToolTip="留空表示用默认色" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="留空表示用默认色。#RRGGBB，例如 #0078D4。改完鼠标划过扇区就能看到效果。" />

            <!-- ============ 行为 ============ -->
            <TextBlock Text="行为" Style="{StaticResource Section}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="展开延迟" Style="{StaticResource Caption}" />
                <TextBox x:Name="OpenDelayBox" Grid.Column="1" Style="{StaticResource Field}"
                         Margin="12,0,0,0" Width="70" HorizontalAlignment="Left"
                         TextChanged="OnDelayChanged" ToolTip="毫秒。留空表示用默认值 200" />
                <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource Caption}" />

                <TextBlock Grid.Row="1" Text="收起延迟" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                <TextBox x:Name="CloseDelayBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}"
                         Margin="12,8,0,0" Width="70" HorizontalAlignment="Left"
                         TextChanged="OnDelayChanged" ToolTip="毫秒。必须大于展开延迟" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="ms" Style="{StaticResource Caption}"
                           Margin="0,8,0,0" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}"
                       Text="留空表示用默认值（展开 200、收起 350）。收起必须大于展开，否则指针掠过扇区边缘时子菜单会闪。悬停有子菜单的扇区即可验证。" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="动画" Style="{StaticResource Caption}" />
                <ComboBox x:Name="AnimationsBox" Grid.Column="1" Margin="12,0,0,0"
                          Width="120" HorizontalAlignment="Left"
                          Background="{DynamicResource Wq.Color.FieldBackground}"
                          Foreground="#FF202020"
                          FontFamily="{DynamicResource Wq.Font.Family}"
                          FontSize="{DynamicResource Wq.Font.BodySize}"
                          SelectionChanged="OnAnimationsChanged" />
            </Grid>

            <CheckBox x:Name="HideOnFocusLossBox" Style="{StaticResource Check}"
                      Content="失去焦点时关闭覆盖层" Click="OnHideOnFocusLossChanged" />

            <!-- ============ 菜单 ============ -->
            <!--
                这里刻意**不再列出菜单项**：加一项在轮盘上点末尾的「＋」就行，
                改名与移除在扇区上点右键。列表放在这里意味着每次增删都要在
                "另一个窗口"和"轮盘"之间来回看，而改动的效果恰恰在轮盘上。
                只留下直接改文件这个入口，给需要批量编辑的场合。
            -->
            <TextBlock Text="菜单" Style="{StaticResource Section}" />
            <!-- 这两行是「＋」与右键的**唯一说明处**：它们只在设置态出现，
                 而编辑态又没有工具栏，所以这里必须把话说清楚，否则用户找不到入口。 -->
            <TextBlock Style="{StaticResource Hint}"
                       Text="加一项：点旁边轮盘上外圈末尾那个「＋」，选中程序即加入。" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="改名或移除：在轮盘的扇区上点右键。子环里的「＋」会把程序加进该子菜单。" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="改动立刻生效，覆盖层不会关闭 —— 加完就能看见新扇区长出来。" />
            <Button Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Content="打开 menus.json" Click="OnOpenMenuFileClick" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="手动编辑配置文件。适合一次改很多项；改坏了不会影响已经生效的那一份。" />

            <!-- ============ 启动 ============ -->
            <TextBlock Text="启动" Style="{StaticResource Section}" />
            <CheckBox x:Name="AutoStartBox" Style="{StaticResource Check}"
                      Content="开机自启" Click="OnAutoStartChanged" />

            <!-- ============ 底部 ============ -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource FlatButton}"
                        Content="打开配置文件夹" Click="OnOpenFolderClick" />
                <Button Grid.Column="2" Style="{StaticResource FlatButton}"
                        Content="恢复默认" Click="OnResetClick" />
            </Grid>

            <TextBlock x:Name="FooterStatus" Style="{StaticResource Hint}" Margin="0,10,0,0"
                       Text="改动即时生效并自动保存。" />
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
