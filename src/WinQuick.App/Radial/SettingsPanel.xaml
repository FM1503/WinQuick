<Window x:Class="WinQuick.App.Radial.SettingsPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinQuick 设置"
        Width="640" MinHeight="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!-- 样式全部走 DynamicResource 引用令牌，不写死任何颜色与字号（与轮盘同源）。
         布局是用户从 preview/settings-preview.html 挑的 ④ 侧栏分区 + 设置卡：
         左栏选分区、右侧只显示当前区 —— 每屏内容量最少，代价是面板宽 640。 -->
    <Window.Resources>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Wq.Color.FieldBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Wq.Color.Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="{DynamicResource Wq.Size.FieldPadding}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.BodySize}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Wq.Color.Text}" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.Text}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.BodySize}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.Text}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PageDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.TextMuted}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.SmallSize}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- 分组卡容器：圆角 + 一圈细描边（WinUI SettingsCardGroup 的做法）。 -->
        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Wq.Color.Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Wq.Size.CornerRadius}" />
        </Style>

        <!-- 设置卡的标题 / 说明：标题加粗、说明小字灰 —— 层级靠字号与字重，不再只靠颜色 -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.Text}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.BodySize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CardDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.TextMuted}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.SmallSize}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.TextMuted}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.SmallSize}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.Text}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.BodySize}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Wq.Color.Stroke}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Wq.Size.ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource Wq.Color.FieldBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧栏导航项：默认灰字，选中变亮 + 右缘一条强调色竖线。
             刻意不用系统 ListBox 的选中底色（蓝色块太重，和深色面板打架）。 -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.TextMuted}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.BodySize}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,2,0"
                                Padding="14,8" Margin="0,1,0,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#08FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource Wq.Color.Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#10FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource Wq.Color.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Wq.Color.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 面板本体：与轮盘扇区同一套材质。左栏选分区（132px）+ 右侧内容。 -->
    <Border Background="{DynamicResource Wq.Color.SurfaceSolid}"
            BorderBrush="{DynamicResource Wq.Color.Stroke}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Wq.Size.CornerRadius}"
            Opacity="0.97">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 侧栏 ============ -->
            <!-- 圆角只在左侧（右上/右下与内容区相连，圆了会露缝）。四元值里拼不了
                 DynamicResource，所以写死 8 —— 与 Size.CornerRadius 的当前值一致，令牌改了要跟。 -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource Wq.Color.Stroke}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="8,0,0,8">
                <ListBox x:Name="NavList"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         Margin="0,10,0,10"
                         SelectionChanged="OnNavChanged">
                    <ListBoxItem>热键</ListBoxItem>
                    <ListBoxItem>外观</ListBoxItem>
                    <ListBoxItem>行为</ListBoxItem>
                    <ListBoxItem>菜单</ListBoxItem>
                    <ListBoxItem>启动队列</ListBoxItem>
                    <ListBoxItem>启动</ListBoxItem>
                </ListBox>
            </Border>

            <!-- ============ 调色盘（Popup） ============
                必须用 Popup 而不是面内覆盖层：面板窗口是固定尺寸的分层窗口，
                面内元素超出窗口边界就被裁掉（用户实测：弹盘下半截没了）。
                Popup 有自己的顶层 HWND，可以自由伸出窗口外；AllowsTransparency
                让伸出窗口外的圆角也正常渲染。窗口高度不因开盘而变 ——
                SizeToContent 不会重建整块表面。 -->
            <Popup x:Name="AccentFlyout" AllowsTransparency="True" StaysOpen="False"
                   PlacementTarget="{Binding ElementName=AccentButton}" Placement="Bottom"
                   VerticalOffset="6" PopupAnimation="Fade">
            <Border Width="266"
                    Background="{DynamicResource Wq.Color.SurfaceSolid}"
                    BorderBrush="{DynamicResource Wq.Color.Stroke}" BorderThickness="1"
                    CornerRadius="{DynamicResource Wq.Size.CornerRadius}" Padding="12">
                <StackPanel>
                    <StackPanel x:Name="FlyPalette">
                        <TextBlock x:Name="FlyRecentLabel" Style="{StaticResource Hint}"
                                   Text="最近使用" Visibility="Collapsed" />
                        <UniformGrid x:Name="FlyRecent" Columns="8" Margin="0,4,0,0" Visibility="Collapsed" />
                        <TextBlock Style="{StaticResource Hint}" Text="常用颜色" Margin="0,2,0,4" />
                        <UniformGrid x:Name="FlyGrid" Columns="8" />
                        <Grid Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl x:Name="FlyDefaultHost" />
                                <TextBlock Style="{StaticResource Hint}" Margin="8,0,0,0"
                                           Text="默认（清掉自定义色）" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="FlyMore" HorizontalAlignment="Right"
                                    Style="{StaticResource FlatButton}" Content="更多颜色…"
                                    Click="OnFlyMoreClick" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="FlyHsv" Visibility="Collapsed">
                        <Grid x:Name="SvSquare" Width="242" Height="118" ClipToBounds="True" Cursor="Cross">
                            <Rectangle x:Name="SvBase" Fill="#FF0000" />
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#FF000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <!-- 圆点必须左上对齐：位移公式按「从左上角算」写的，
                                 默认居中会让它带着半格偏移跑（表现为不跟手）。 -->
                            <Ellipse x:Name="SvDot" Width="12" Height="12" Stroke="#FFFFFFFF"
                                     StrokeThickness="2" IsHitTestVisible="False"
                                     HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="SvDotTransform" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <Grid x:Name="HueBar" Width="242" Height="12" Margin="0,10,0,0"
                              ClipToBounds="True" Cursor="Cross">
                            <Rectangle>
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF0000" Offset="0" />
                                        <GradientStop Color="#FFFF00" Offset="0.1667" />
                                        <GradientStop Color="#00FF00" Offset="0.3333" />
                                        <GradientStop Color="#00FFFF" Offset="0.5" />
                                        <GradientStop Color="#0000FF" Offset="0.6667" />
                                        <GradientStop Color="#FF00FF" Offset="0.8333" />
                                        <GradientStop Color="#FF0000" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle x:Name="HueThumb" Width="6" Height="18" Fill="Transparent"
                                       Stroke="#FFFFFFFF" StrokeThickness="2" RadiusX="3" RadiusY="3"
                                       IsHitTestVisible="False" Margin="0,-3,0,-3"
                                       HorizontalAlignment="Left">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="HueThumbTransform" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentControl x:Name="FlyDefaultHost2" />
                                <TextBlock Style="{StaticResource Hint}" Margin="8,0,0,0"
                                           Text="默认（清掉自定义色）" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="FlyBack" HorizontalAlignment="Right"
                                    Style="{StaticResource FlatButton}" Content="返回色板"
                                    Click="OnFlyBackClick" />
                        </Grid>
                        <TextBox x:Name="FlyHex" Style="{StaticResource Field}" Width="100"
                                 Margin="0,8,0,0" HorizontalAlignment="Left" FontFamily="Consolas"
                                 ToolTip="#RRGGBB；输完整才生效" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </Popup>

            <!-- ============ 右侧：标题（拖动把手）+ 当前分区 + 底栏 ============ -->
            <DockPanel Grid.Column="1" Margin="16,12,18,14">

                <!-- 标题栏。**它同时是拖动把手**：标题区按住就能把面板拖开。 -->
                <Grid x:Name="TitleBar" DockPanel.Dock="Top" Background="Transparent"
                      Cursor="SizeAll" ToolTip="按住可拖动面板" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageHeader" Grid.Column="0" Text="热键"
                               Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource FlatButton}"
                            Padding="9,2" Content="✕" Click="OnCloseClick"
                            ToolTip="关闭设置（Esc）" />
                </Grid>

                <!-- 底栏常驻（不跟着分区走）：操作按钮 + 状态行。
                     页脚高度写死两行：文本一变行数、窗口就改高度，
                     而分层窗口改高度会重建整块表面（观感就是每操作一次闪一下）。 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource FlatButton}"
                                Content="打开配置文件夹" Click="OnOpenFolderClick" />
                        <Button Grid.Column="2" Style="{StaticResource FlatButton}"
                                Content="恢复默认" Click="OnResetClick" />
                    </Grid>
                    <TextBlock x:Name="FooterStatus" Style="{StaticResource Hint}" Margin="0,10,0,0"
                               MinHeight="{DynamicResource Wq.Size.FooterMinHeight}"
                               Text="改动即时生效并自动保存。" />
                </StackPanel>

                <!-- 当前分区的内容。可滚动：小屏上每页也可能超过可用高度。 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid>
                        <!-- ============ 热键 ============ -->
                        <StackPanel x:Name="PageHotkey">
                            <TextBlock Style="{StaticResource PageDesc}"
                                       Text="唤出轮盘的组合键。选一个预设，或选「自定义…」后直接按下组合键。" />
                            <Border Style="{StaticResource GroupCard}" Margin="0,10,0,0">
                                <StackPanel Margin="14,10,14,12">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="预设" />
                                    <ComboBox x:Name="PresetBox" Margin="0,7,0,0"
                                              HorizontalAlignment="Left" MinWidth="180"
                                              SelectionChanged="OnPresetChanged"
                                              ToolTip="挑一个不易与系统或其他软件冲突的组合" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GroupCard}" Margin="0,8,0,0">
                                <StackPanel Margin="14,10,14,12">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="自定义" />
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="HotkeyBox" Grid.Column="0" Style="{StaticResource Field}"
                                                 IsReadOnly="True" FontSize="15"
                                                 PreviewKeyDown="OnHotkeyKeyDown"
                                                 GotKeyboardFocus="OnHotkeyFocused"
                                                 ToolTip="点这里然后按下想要的组合键" />
                                        <Button x:Name="TestButton" Grid.Column="1" Style="{StaticResource FlatButton}"
                                                Margin="8,0,0,0" Content="测试" Click="OnTestHotkeyClick" />
                                    </Grid>
                                    <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ 外观 ============ -->
                        <StackPanel x:Name="PageLook" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource PageDesc}"
                                       Text="材质与遮罩。改动立刻在旁边的轮盘上可见。" />
                            <Border Style="{StaticResource GroupCard}" Margin="0,10,0,0">
                                <Grid Margin="14,10,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" MinWidth="52" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="遮罩深浅" />
                                        <TextBlock Style="{StaticResource CardDesc}"
                                                   Text="唤出时压暗背景的程度；40% 是默认值" />
                                    </StackPanel>
                                    <Slider x:Name="DimSlider" Grid.Column="1" Width="150" Margin="14,0"
                                            Minimum="0" Maximum="0.9" TickFrequency="0.05"
                                            IsSnapToTickEnabled="True" ValueChanged="OnDimChanged" />
                                    <TextBlock x:Name="DimValue" Grid.Column="2" Style="{StaticResource Caption}"
                                               TextAlignment="Right" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource GroupCard}" Margin="0,8,0,0">
                                <Grid Margin="14,10,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="悬停高亮色" />
                                        <TextBlock Style="{StaticResource CardDesc}"
                                                   Text="点色块选颜色；「默认」= 沿用设计基线" />
                                    </StackPanel>
                                    <Button x:Name="AccentButton" Grid.Column="1" Style="{StaticResource FlatButton}"
                                            Padding="4,3" Click="OnAccentButtonClick"
                                            ToolTip="点击选择颜色">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="AccentSwatch" Width="46" Height="22"
                                                    CornerRadius="3" BorderBrush="{DynamicResource Wq.Color.Stroke}"
                                                    BorderThickness="1" />
                                            <TextBlock x:Name="AccentHexLabel" VerticalAlignment="Center"
                                                       Margin="8,0,4,0" FontFamily="Consolas"
                                                       FontSize="{DynamicResource Wq.Font.SmallSize}"
                                                       Foreground="{DynamicResource Wq.Color.TextMuted}"
                                                       Text="默认" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource GroupCard}" Margin="0,8,0,0">
                                <Grid Margin="14,10,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="皮肤与形态" />
                                        <TextBlock Style="{StaticResource CardDesc}"
                                                   Text="换皮肤同时改材质与动效；形态换单元外形" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource FlatButton}"
                                            Content="打开…" Click="OnSkinClick" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ============ 行为 ============ -->
                        <StackPanel x:Name="PageBehavior" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource PageDesc}"
                                       Text="（悬停展开/收起延迟两项已随「点击展开」移除 —— 悬停不再展开子菜单。）" />
                            <Border Style="{StaticResource GroupCard}" Margin="0,10,0,0">
                                <Grid Margin="14,10,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="动画" />
                                        <TextBlock Style="{StaticResource CardDesc}"
                                                   Text="跟随系统「显示动画」设置，或强制开/关" />
                                    </StackPanel>
                                    <ComboBox x:Name="AnimationsBox" Grid.Column="1" Width="120"
                                              SelectionChanged="OnAnimationsChanged" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource GroupCard}" Margin="0,8,0,0">
                                <Grid Margin="14,10,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="失去焦点时关闭" />
                                        <TextBlock Style="{StaticResource CardDesc}"
                                                   Text="点别的窗口时轮盘自动收起" />
                                    </StackPanel>
                                    <CheckBox x:Name="HideOnFocusLossBox" Grid.Column="1"
                                              Click="OnHideOnFocusLossChanged" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ============ 菜单 ============ -->
                        <StackPanel x:Name="PageMenu" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource PageDesc}"
                                       Text="加项/建分组都在轮盘上操作，这里只留说明与配置文件入口。" />
                            <Border Style="{StaticResource GroupCard}" Margin="0,10,0,0">
                                <StackPanel Margin="14,10,14,12">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="怎么加项" />
                                    <TextBlock Style="{StaticResource CardDesc}" Margin="0,3,0,0"
                                               Text="编辑态下点外圈末尾的「＋」选程序；子环里的「＋」加进该子菜单。" />
                                    <TextBlock Style="{StaticResource CardTitle}" Text="怎么建分组" Margin="0,9,0,0" />
                                    <TextBlock Style="{StaticResource CardDesc}" Margin="0,3,0,0"
                                               Text="点「＋」后选「新建分组…」；子环里的「＋」也能建 —— 建出来的是更深一级。点开分组还能继续往下。" />
                                    <TextBlock Style="{StaticResource CardTitle}" Text="改名 / 移除" Margin="0,9,0,0" />
                                    <TextBlock Style="{StaticResource CardDesc}" Margin="0,3,0,0"
                                               Text="在扇区上点右键。改动立刻生效，覆盖层不会关闭。" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GroupCard}" Margin="0,8,0,0">
                                <Grid Margin="14,10,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="menus.json" />
                                        <TextBlock Style="{StaticResource CardDesc}"
                                                   Text="手动批量编辑配置文件；改坏了不影响已生效的那份" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource FlatButton}"
                                            Content="打开" Click="OnOpenMenuFileClick" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ============ 启动 ============ -->
                        <StackPanel x:Name="PageStartup" Visibility="Collapsed">
                            <Border Style="{StaticResource GroupCard}" Margin="0,0,0,0">
                                <StackPanel Margin="14,10,14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="开机自启" />
                                            <TextBlock Style="{StaticResource CardDesc}"
                                                       Text="登录后自动驻留（热键随时唤出）" />
                                        </StackPanel>
                                        <CheckBox x:Name="AutoStartBox" Grid.Column="1"
                                                  Click="OnAutoStartChanged" />
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="文件右键菜单" />
                                            <TextBlock Style="{StaticResource CardDesc}"
                                                       Text="Win11 在「显示更多选项」里（或 Shift+F10）—— 新版紧凑菜单不接受这种注册方式" />
                                        </StackPanel>
                                        <CheckBox x:Name="ShellMenuBox" Grid.Column="1"
                                                  Click="OnShellMenuChanged" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============ 启动队列 ============
                             版式是用户从 preview/queuepanel-preview.html 挑的 ① 档：行内操作列表。
                             条目列表由代码建行（每行带闭包要吃当前下标，纯 XAML 的 ItemsControl
                             光靠模板表达不了"上移/下移/移除"，见 RenderQueuePage）。 -->
                        <StackPanel x:Name="PageQueues" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource PageDesc}"
                                       Text="一组按间隔依次打开的程序与文件夹。同一时间只跑一套；某一项目标不存在只会跳过该项。改动即时保存。" />
                            <Border Style="{StaticResource GroupCard}" Margin="0,10,0,0">
                                <StackPanel Margin="14,10,14,12">

                                    <!-- 头部：队列选择（与改名框叠在同一格里，二选一显示） -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <ComboBox x:Name="QueueSelect" MinWidth="140"
                                                      HorizontalAlignment="Left"
                                                      SelectionChanged="OnQueueSelected" />
                                            <TextBox x:Name="QueueNameBox" Style="{StaticResource Field}"
                                                     HorizontalAlignment="Left" MinWidth="140" MaxWidth="320"
                                                     Visibility="Collapsed"
                                                     KeyDown="OnQueueNameKeyDown"
                                                     LostFocus="OnQueueNameLostFocus" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource FlatButton}" Padding="9,4"
                                                    Margin="8,0,0,0" Content="新建"
                                                    Click="OnQueueNewClick" ToolTip="新建一套空队列" />
                                            <Button x:Name="QueueRenameButton" Style="{StaticResource FlatButton}"
                                                    Padding="9,4" Margin="6,0,0,0" Content="改名"
                                                    Click="OnQueueRenameClick" ToolTip="给当前队列改名" />
                                            <Button x:Name="QueueDeleteButton" Style="{StaticResource FlatButton}"
                                                    Padding="9,4" Margin="6,0,0,0" Content="删除"
                                                    Click="OnQueueDeleteClick" ToolTip="删除当前队列" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 空状态两档（第三档"不可用"复用 QueueNoQueues 的文案位，由代码改字）：
                                         没有任何队列 / 当前队列没有条目 -->
                                    <StackPanel x:Name="QueueNoQueues" Margin="0,16,0,10" Visibility="Collapsed">
                                        <TextBlock x:Name="QueueNoQueuesLabel" Style="{StaticResource CardDesc}"
                                                   HorizontalAlignment="Center" Text="还没有队列" />
                                        <Button x:Name="QueueNoQueuesButton" Style="{StaticResource FlatButton}"
                                                Margin="0,10,0,0" Padding="20,8" FontSize="15"
                                                HorizontalAlignment="Center" Content="新建"
                                                Click="OnQueueNewClick" />
                                    </StackPanel>
                                    <TextBlock x:Name="QueueNoItems" Style="{StaticResource CardDesc}"
                                               Margin="0,16,0,10" Visibility="Collapsed"
                                               Text="还没有队列" />
                                    <TextBlock x:Name="QueueEmptyItems" Style="{StaticResource Hint}"
                                               Margin="0,10,0,4" Visibility="Collapsed"
                                               Text="点「添加…」把要启动的程序与文件夹加进来" />

                                    <!-- 条目列表。高度写死：SizeToContent 的面板里，列表随条目增减变高
                                         会让窗口每次改动都重建整块分层表面（观感是每加一项闪一下），
                                         而分层窗口改高度本来就不便宜（见 M0 的实测结论）。 -->
                                    <Border x:Name="QueueListBorder" Margin="0,10,0,0"
                                            Height="216"
                                            BorderBrush="{DynamicResource Wq.Color.Stroke}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Wq.Size.CornerRadius}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="QueueItemsPanel" />
                                        </ScrollViewer>
                                    </Border>

                                    <!-- 底部：添加 + 间隔 -->
                                    <StackPanel x:Name="QueueAddRow" Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="QueueAddButton" Style="{StaticResource FlatButton}"
                                                Content="添加…" Click="OnQueueAddClick"
                                                ToolTip="选一个系统位置、文件或文件夹加进队列末尾" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="14,0,6,0" Text="间隔" />
                                        <TextBox x:Name="QueueIntervalBox" Style="{StaticResource Field}"
                                                 Width="62" TextAlignment="Center"
                                                 KeyDown="OnQueueIntervalKeyDown"
                                                 LostFocus="OnQueueIntervalLostFocus"
                                                 ToolTip="相邻两项之间等待的毫秒数，0–5000" />
                                        <TextBlock x:Name="QueueIntervalNote" Style="{StaticResource Hint}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</Window>
