<Window x:Class="WinQuick.App.Radial.SkinPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinQuick 皮肤"
        Width="366" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!-- 与设置面板同一套做法、同一套令牌：
         · 全部颜色/字号走 DynamicResource 引令牌，**换皮肤时这里跟着变**（Install(force:true) 一次重装）；
         · 窗口属性（无边框、逐像素 alpha、置顶、不进任务栏）与设置面板逐条一致；
         · 标题栏按住即可拖动，用的是同一份 WindowDrag 实现。
         显示层级也由 OverlayController 的 z 序栈声明（紧挨着设置面板那一层）。 -->
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.Text}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.BodySize}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">

            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.Text}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.BodySize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.TextMuted}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.SmallSize}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Wq.Color.Text}" />
            <Setter Property="FontFamily" Value="{DynamicResource Wq.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Wq.Font.BodySize}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent"
                                CornerRadius="{DynamicResource Wq.Size.ControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource Wq.Color.Stroke}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 面板本体：与轮盘扇区同一套材质 —— 半透明底 + 一圈细描边 + 圆角。 -->
    <Border Background="{DynamicResource Wq.Color.SurfaceSolid}"
            BorderBrush="{DynamicResource Wq.Color.Stroke}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Wq.Size.CornerRadius}">
        <StackPanel Margin="18,14,18,16">

            <Grid x:Name="TitleBar" Background="Transparent" Cursor="SizeAll"
                  ToolTip="按住可拖动面板">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="皮肤"
                           Foreground="{DynamicResource Wq.Color.Text}"
                           FontFamily="{DynamicResource Wq.Font.Family}"
                           FontSize="{DynamicResource Wq.Font.BodySize}"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{DynamicResource FlatButton}" Content="✕"
                        Click="OnCloseClick" />
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <StackPanel>
                    <TextBlock Text="皮肤（材质 + 动效）" Style="{DynamicResource Section}" />
                    <StackPanel x:Name="SkinList" />

                    <TextBlock Text="盘面形态" Style="{DynamicResource Section}" />
                    <StackPanel x:Name="FormList" />
                    <TextBlock Style="{DynamicResource Hint}"
                               Text="形态与皮肤正交：皮肤换材质与动效，形态换单元的外形。四种形态共用同一套角度区间，命中与交互不变。" />

                    <TextBlock x:Name="FooterStatus" Style="{DynamicResource Hint}" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
