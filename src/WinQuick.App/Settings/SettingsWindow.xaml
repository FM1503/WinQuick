<Window x:Class="WinQuick.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinQuick 设置"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1F1F1F" Foreground="#FFF0F0F0"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF0F0F0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2B2B2B" />
            <Setter Property="Foreground" Value="#FFF0F0F0" />
            <Setter Property="BorderBrush" Value="#FF3A3A3A" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF0F0F0" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF2B2B2B" />
            <Setter Property="Foreground" Value="#FF202020" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="Foreground" Value="#FF9CC7E8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9A9A9A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,14,18,16">

        <!-- ============ 热键 ============ -->
        <TextBlock Text="热键" Style="{StaticResource SectionTitle}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="HotkeyBox" Grid.Column="0" IsReadOnly="True"
                     FontFamily="Consolas, Microsoft YaHei UI" FontSize="14"
                     PreviewKeyDown="OnHotkeyBoxKeyDown"
                     GotKeyboardFocus="OnHotkeyBoxFocused"
                     ToolTip="点这里然后按下想要的组合键" />

            <Button x:Name="ApplyHotkeyButton" Grid.Column="1" Margin="8,0,0,0"
                    Padding="10,3" Content="应用" Click="OnApplyHotkeyClick" />
        </Grid>

        <TextBlock x:Name="HotkeyStatus" Margin="0,6,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Hint}" Margin="0,2,0,0"
                   Text="点上面的输入框，然后按下想要的组合键。必须有至少一个修饰键（Ctrl / Win / Alt / Shift）。" />

        <!-- ============ 外观 ============ -->
        <TextBlock Text="外观" Style="{StaticResource SectionTitle}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="遮罩不透明度" VerticalAlignment="Center" />
            <Slider x:Name="DimSlider" Grid.Column="1" Margin="10,0" Minimum="0" Maximum="0.9"
                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                    ValueChanged="OnDimChanged" />
            <TextBlock x:Name="DimValue" Grid.Column="2" Width="42" TextAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>
        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                   Text="0 = 不压暗；数值越大屏幕越暗。40% 是默认值。" />

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="悬停高亮色" VerticalAlignment="Center" />
            <TextBox x:Name="AccentBox" Grid.Column="1" Margin="10,0,0,0" Width="110"
                     HorizontalAlignment="Left" FontFamily="Consolas"
                     ToolTip="留空表示用默认色。格式 #RRGGBB" />
        </Grid>
        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                   Text="留空表示用默认色。#RRGGBB 格式，例如 #0078D4。" />

        <!-- ============ 行为 ============ -->
        <TextBlock Text="行为" Style="{StaticResource SectionTitle}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="悬停展开延迟" VerticalAlignment="Center" />
            <TextBox x:Name="OpenDelayBox" Grid.Column="1" Width="64" Margin="10,0,0,0"
                     ToolTip="毫秒。留空表示用默认值 200" />
            <TextBlock Grid.Column="2" Text="ms" Margin="4,0,0,0" VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Text="悬停收起延迟" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox x:Name="CloseDelayBox" Grid.Row="1" Grid.Column="1" Width="64"
                     Margin="10,8,0,0" ToolTip="毫秒。必须大于展开延迟" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="ms" Margin="4,8,0,0" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                   Text="留空表示用默认值（展开 200、收起 350）。收起必须大于展开，否则指针掠过扇区边缘时子菜单会闪。" />

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="动画" VerticalAlignment="Center" />
            <ComboBox x:Name="AnimationsBox" Grid.Column="1" Width="130" Margin="10,0,0,0"
                      HorizontalAlignment="Left" />
        </Grid>

        <CheckBox x:Name="HideOnFocusLossBox" Content="失去焦点时关闭覆盖层" />

        <!-- ============ 启动 ============ -->
        <TextBlock Text="启动" Style="{StaticResource SectionTitle}" />
        <CheckBox x:Name="AutoStartBox" Content="开机自启（写入当前用户的启动项）" />

        <!-- ============ 底部按钮 ============ -->
        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Padding="10,4" Content="打开配置文件夹" Click="OnOpenConfigFolderClick" />
            <Button Grid.Column="2" Padding="10,4" Content="恢复默认" Margin="0,0,8,0" Click="OnResetClick" />
            <Button Grid.Column="3" Padding="16,4" Content="保存" IsDefault="True" Click="OnSaveClick" />
        </Grid>

        <TextBlock x:Name="SaveStatus" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
