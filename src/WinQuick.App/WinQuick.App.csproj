<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
<TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>WinQuick.App</RootNamespace>
    <AssemblyName>WinQuick</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/winquick.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 把 CsWin32 源生成器的产物落到 obj 下，方便排查签名与可访问性问题 -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinQuick.Core\WinQuick.Core.csproj" />
  </ItemGroup>

  <!-- 探针与单测的可见性来源。
       为什么不让那些 *ForProbe 成员变成 public：它们是**测试接缝**，不是产品接口 ——
       放进 public 就等于承诺长期维护它们（见 docs/review-2026-09.md 的 P2/P3）。
       单测也要拿到 internal：纯逻辑（如 ExplorerTabs.UrlMatches 的比较口径）只有能被直接断言，
       才不会退回到「靠跑一次真实资源管理器去猜」。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="WinQuick.Probes" />
    <InternalsVisibleTo Include="WinQuick.Core.Tests" />
  </ItemGroup>

  <!-- CsWin32 reads this to decide which Win32 APIs to project. Keeping the list
       explicit means generated signatures can't drift out from under us. -->
  <ItemGroup>
    <AdditionalFiles Include="NativeMethods.txt" />
  </ItemGroup>

  <!-- 视觉规格的单一真源以嵌入资源形式带上。用资源而不是代码生成，
       是为了不存在"改了 JSON 忘了重新生成"的第二种真源。 -->
  <ItemGroup>
    <EmbeddedResource Include="../../design/tokens.json" LogicalName="WinQuick.tokens.json" />
    <!-- 皮肤目录：每套皮肤是一组**局部**的令牌覆盖，合并到上面的基线上，
         合并结果仍然跑同一套不变量校验（DesignTokens.Validate）。 -->
    <EmbeddedResource Include="../../design/skins.json" LogicalName="WinQuick.skins.json" />
    <!-- 托盘图标从嵌入资源加载，而不是 System.Drawing.SystemIcons.Application。
         用系统图标本来是临时占位，而它一旦加载失败就完全没有兜底路径 ——
         托盘会变成一个没有图标的条目，Windows 可能根本不显示它。 -->
    <EmbeddedResource Include="../../assets/winquick.ico" LogicalName="WinQuick.tray.ico" />
  </ItemGroup>

</Project>
